{
  "name": "Spectra",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "tts",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Start Spectra"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start Spectra Analysis"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/domExtractor.js", 
        "scripts/api.js", 
        "scripts/mainContent.js"
      ]
    }
  ]
}